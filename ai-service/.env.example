# Copy to ai-service/.env (git-ignored) and fill in. Never commit real values.

# Google AI Studio -> Get API key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EXTRACT_MODEL=gemini-3.1-flash-lite

# Spring backend
BACKEND_BASE_URL=http://localhost:8080

# Shared secret between Spring and ai-service (same value in Spring: app.ai-service.token / env INTERNAL_TOKEN)
INTERNAL_TOKEN=change-me-32-chars

# Timeouts (seconds)
BACKEND_TIMEOUT_S=10
GEMINI_TIMEOUT_S=30
